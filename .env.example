NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Keep both switches false until the NEW academy migration and auth are verified.
# The server switch cannot be enabled by a browser build flag alone.
ACADEMY_BACKEND_ENABLED=false
NEXT_PUBLIC_ACADEMY_BACKEND_ENABLED=false
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Compatibility only: use a publishable key for the new project.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Test keys must start rzp_test_; live keys must start rzp_live_. Never expose secret.
ACADEMY_PAYMENT_MODE=unconfigured
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_MEMBERSHIP_PLAN_ID=
RAZORPAY_WEBHOOK_SECRET=
# Optional previous secret during webhook secret rotation/retry overlap.
RAZORPAY_WEBHOOK_SECRET_PREVIOUS=

# Protects GET /api/cron/reconcile; use a strong random secret.
CRON_SECRET=
